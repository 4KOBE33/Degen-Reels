{
  "name": "degen-reels",
  "version": "0.1.0",
  "description": "Cartoony multiplayer casino shooter: gamble for your gun, shoot for their chips.",
  "main": "server/index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=public/game.js",
    "build:artifact": "npm run build && node scripts/build-artifact.js",
    "start": "npm run build && node server/index.js",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "three": "^0.169.0",
    "ws": "^8.22.0"
  }
}
